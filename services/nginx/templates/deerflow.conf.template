# DeerFlow edge routing for Railway. Rendered at container start by the nginx
# image's envsubst step (only PORT, DEERFLOW_* and NGINX_* are substituted).
# Route table adapted from bytedance/deer-flow v2.1.0 docker/nginx/nginx.conf
# (MIT); the provisioner route is omitted (no Kubernetes sandbox on Railway).

gzip on;
gzip_vary on;
gzip_proxied any;
gzip_min_length 1024;
gzip_comp_level 5;
gzip_types text/css text/javascript application/javascript application/json application/xml image/svg+xml;

# Railway terminates TLS and always sends X-Forwarded-Proto: https.
map $http_x_forwarded_proto $forwarded_proto {
    default    $scheme;
    "~*^https" https;
}

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      '';
}

server {
    listen ${PORT} default_server;
    listen [::]:${PORT} default_server;
    server_name _;

    # Railway private DNS (*.railway.internal), resolved per request so this
    # service can boot before the Gateway and Frontend and survives redeploys.
    resolver ${NGINX_LOCAL_RESOLVERS} valid=10s;
    resolver_timeout 5s;

    # Railway's edge puts the client address in X-Real-IP. Restore it so the
    # Gateway's per-IP login lockout counts real clients, not this proxy.
    set_real_ip_from 0.0.0.0/0;
    set_real_ip_from ::/0;
    real_ip_header X-Real-IP;

    set $gateway_upstream ${DEERFLOW_GATEWAY_UPSTREAM};
    set $frontend_upstream ${DEERFLOW_FRONTEND_UPSTREAM};

    proxy_buffering off;
    proxy_cache off;

    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    # First-run admin creation. The Gateway creates the admin itself from its
    # DEERFLOW_ADMIN_EMAIL / DEERFLOW_ADMIN_PASSWORD variables over loopback,
    # so nobody on the internet can race for the instance. Set
    # DEERFLOW_ALLOW_PUBLIC_SETUP=true on this service to use the browser
    # /setup page instead.
    location = /api/v1/auth/initialize {
        default_type application/json;
        set $deerflow_public_setup "${DEERFLOW_ALLOW_PUBLIC_SETUP}";
        if ($deerflow_public_setup != "true") {
            return 403 '{"detail":"First-run setup is disabled on the public URL. The admin account is created from DEERFLOW_ADMIN_EMAIL and DEERFLOW_ADMIN_PASSWORD on the Gateway service."}';
        }
        proxy_pass http://$gateway_upstream;
        include /etc/nginx/snippets/deerflow_proxy.conf;
    }

    # LangGraph-compatible API: /api/langgraph/* -> Gateway /api/*
    location /api/langgraph/ {
        rewrite ^/api/langgraph/(.*) /api/$1 break;
        proxy_pass http://$gateway_upstream;
        include /etc/nginx/snippets/deerflow_proxy.conf;
        proxy_set_header Connection '';
        proxy_set_header X-Accel-Buffering no;
        client_max_body_size 20M;
        proxy_request_buffering off;
        proxy_connect_timeout 600s;
        proxy_send_timeout 600s;
        proxy_read_timeout 600s;
        chunked_transfer_encoding on;
    }

    # Admin-only .skill archive upload
    location = /api/skills/install/upload {
        proxy_pass http://$gateway_upstream;
        include /etc/nginx/snippets/deerflow_proxy.conf;
        client_max_body_size 101M;
        proxy_request_buffering off;
        proxy_read_timeout 600s;
    }

    # Thread file uploads
    location ~ ^/api/threads/[^/]+/uploads {
        proxy_pass http://$gateway_upstream;
        include /etc/nginx/snippets/deerflow_proxy.conf;
        client_max_body_size 100M;
        proxy_request_buffering off;
    }

    # Live browser stream (WebSocket), before the generic /api/threads rule
    location ~ ^/api/threads/[^/]+/browser/stream {
        proxy_pass http://$gateway_upstream;
        include /etc/nginx/snippets/deerflow_proxy.conf;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_cache_bypass $http_upgrade;
        proxy_connect_timeout 600s;
        proxy_send_timeout 600s;
        proxy_read_timeout 600s;
    }

    # Other thread endpoints (/compact, /suggestions, /runs/wait hold the
    # response open for a model call)
    location ~ ^/api/threads {
        proxy_pass http://$gateway_upstream;
        include /etc/nginx/snippets/deerflow_proxy.conf;
        proxy_read_timeout 600s;
    }

    # Everything else under /api/ (models, memory, mcp, skills, agents,
    # v1/auth/*, ...) goes to the Gateway.
    location /api/ {
        proxy_pass http://$gateway_upstream;
        include /etc/nginx/snippets/deerflow_proxy.conf;
        proxy_read_timeout 600s;
    }

    # Gateway health and (when GATEWAY_ENABLE_DOCS=true) API docs
    location = /health {
        proxy_pass http://$gateway_upstream;
        include /etc/nginx/snippets/deerflow_proxy.conf;
    }
    location /health/ {
        proxy_pass http://$gateway_upstream;
        include /etc/nginx/snippets/deerflow_proxy.conf;
    }
    location /docs {
        proxy_pass http://$gateway_upstream;
        include /etc/nginx/snippets/deerflow_proxy.conf;
    }
    location /redoc {
        proxy_pass http://$gateway_upstream;
        include /etc/nginx/snippets/deerflow_proxy.conf;
    }
    location = /openapi.json {
        proxy_pass http://$gateway_upstream;
        include /etc/nginx/snippets/deerflow_proxy.conf;
    }

    # Next.js frontend
    location / {
        proxy_pass http://$frontend_upstream;
        include /etc/nginx/snippets/deerflow_proxy.conf;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_cache_bypass $http_upgrade;
        proxy_connect_timeout 600s;
        proxy_send_timeout 600s;
        proxy_read_timeout 600s;
    }
}
